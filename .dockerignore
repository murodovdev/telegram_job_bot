# Files excluded from the Docker build context.
# Keeps the image lean and prevents secrets/dev files from being copied.

# Local session files — never bake credentials into the image
sessions/
*.session
*.session-journal

# Local database and logs — these live on Railway Volume at /data, not in the image
data/
logs/

# Dev and patch scripts
generate_session.py
fix_chat_ids.py
patch_create_task.py

# Git and IDE
.git/
.gitignore
.github/
.idea/
*.pyc
__pycache__/

# Local env file — secrets come from Railway environment variables at runtime
.env

# Docs
README.md
