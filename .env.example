# ─────────────────────────────────────────────────────────────────────────────
#  Korea Ish E'lonlari Bot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram API (https://my.telegram.org/apps) ──────────────────────────────
API_ID=
API_HASH=

# ── Account 1 — Primary monitoring account (required) ────────────────────────
# Use a DEDICATED account added only to source groups.
# Personal accounts with 500+ groups cause MTProto delivery delays.
PHONE_NUMBER=
SESSION_STRING=           # Run python generate_session.py to get this

# ── Account 2 — Backup/secondary account (optional) ──────────────────────────
# Leave empty to run with Account 1 only.
PHONE_NUMBER_2=
SESSION_STRING_2=

# ── Admin bot (from @BotFather) ───────────────────────────────────────────────
BOT_TOKEN=
ADMIN_USER_ID=            # Your numeric Telegram ID — message @userinfobot

# ── Target group ──────────────────────────────────────────────────────────────
# Username (without @) or numeric ID of the group to forward posts to.
TARGET_GROUP=

# ── Groq AI halal filter (optional) ──────────────────────────────────────────
# Leave empty to disable AI halal screening (keyword filter still runs).
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for auto-detection:
#   Railway deployment: /data/job_bot.db  (attach a Volume at /data)
#   Local development:  data/job_bot.db
DATABASE_PATH=

# ── Deduplication ─────────────────────────────────────────────────────────────
DEDUP_WINDOW_HOURS=24           # Hours to remember forwarded posts (0 = disabled)
DEDUP_SIMILARITY_THRESHOLD=0.85 # Fuzzy match threshold 0.0–1.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG / INFO / WARNING / ERROR