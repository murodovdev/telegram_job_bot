# ─────────────────────────────────────────────────────────────────
#  Korea Ish E'lonlari Bot — Environment Configuration
# ─────────────────────────────────────────────────────────────────

# ── Telegram API (https://my.telegram.org/apps) ──────────────────
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+your_phone_number

# ── Admin Bot Token (from @BotFather) ─────────────────────────────
BOT_TOKEN=your_bot_token_here

# ── Your Telegram user ID (from @userinfobot) ────────────────────
ADMIN_USER_ID=your_telegram_user_id

# ── Target group username or numeric ID ──────────────────────────
TARGET_GROUP=KoreaIshElonlari

# ── Session (choose ONE of the two options below) ─────────────────

# Option A: STRING SESSION — recommended for Railway / cloud deploy
# Run generate_session.py once locally to get this value.
# Leave empty for local file-based session.
SESSION_STRING=

# Option B: FILE SESSION — for local development only
# Path to the .session file (relative to project root)
SESSION_NAME=sessions/userbot

# ── Database ──────────────────────────────────────────────────────
DATABASE_PATH=data/job_bot.db

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
